<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tvFoodTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/was_soll_es_zu_essen_geben"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <RadioGroup
        android:id="@+id/rgFood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvFoodTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/rbItalian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/italienisch"
            android:textSize="18sp"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/rbGerman"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/deutsch"
            android:textSize="18sp"
            android:padding="8dp"/>

        <RadioButton
            android:id="@+id/rbGreek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/griechisch"
            android:textSize="18sp"
            android:padding="8dp"/>
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveFood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/speichern"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/rgFood"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvOrderReminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/order_reminder"
        android:textColor="#FF0000"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/btnSaveFood"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>